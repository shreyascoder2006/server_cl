# ---------------------------------------------------------------------------
# Cloudlead Infra Store - environment configuration
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Server
PORT=4000
# Used to encrypt session cookies and provider secrets saved via admin. Use a long random string.
APP_SECRET=change-me-to-a-long-random-string
# Where the SQLite database lives (local development).
DATABASE_PATH=./data/cloudlead-infra.sqlite

# Global provider mode: "mock" (default, nothing is ever bought) or "live".
# Each provider can also be switched individually in Admin > Integrations,
# but a provider can only go live when this is "live" AND its credentials are set.
PROVIDER_MODE=mock

# --- NameSilo (domains, .com only) ---
NAMESILO_API_KEY=
# Set to the sandbox host NameSilo issues on request, or leave as production.
NAMESILO_BASE_URL=https://www.namesilo.com/api
# Optional: NameSilo payment profile id used for registrations (else account funds).
NAMESILO_PAYMENT_ID=

# --- Mailpool (Google Workspace, Microsoft 365, shared SMTP mailboxes) ---
MAILPOOL_API_KEY=
# Base URL is provided by Mailpool when API access is granted.
MAILPOOL_BASE_URL=

# --- InboxKit (Microsoft 365, Azure, pre-warmed mailboxes) ---
INBOXKIT_API_KEY=
INBOXKIT_BASE_URL=https://api.inboxkit.com
INBOXKIT_WORKSPACE_ID=

# --- Cloudflare (DNS automation). Use an account API token with Zone:Edit + DNS:Edit only. ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- OVHcloud US (raw SMTP servers / VPS) ---
OVH_ENDPOINT=https://api.us.ovhcloud.com/1.0
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_SUBSIDIARY=US

# --- Stripe (left for Akshay) ---
PAYMENT_GATEWAY=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
