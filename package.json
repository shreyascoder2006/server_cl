{
  "name": "cloudlead-infra-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudlead infrastructure store: domains, mailboxes, SMTP servers and pre-warmed inboxes with guided checkout (local build, Stripe handoff).",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "npm install && npm run db:reset",
    "db:reset": "node --no-warnings --import tsx server/cli/reset-db.ts",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --no-warnings --watch --import tsx server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && node --no-warnings --import tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
